{
  "name": "parallax-visualizer",
  "version": "1.0.8",
  "type": "module",
  "description": "Real-time ASCII audio visualizer with 25+ mesmerizing modes. Transform music into art with frequency bars, matrix rain, quantum fields, and more. Perfect for web apps, React projects, and interactive experiences.",
  "main": "dist/parallax-visualizer.cjs.cjs",
  "module": "dist/parallax-visualizer.esm.js",
  "browser": "dist/parallax-visualizer.umd.js",
  "types": "src/types/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": "./dist/parallax-visualizer.esm.js",
      "require": "./dist/parallax-visualizer.cjs.cjs",
      "types": "./src/types/index.d.ts"
    },
    "./react": {
      "import": "./src/react/index.js",
      "require": "./src/react/index.js",
      "types": "./src/types/react.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "npm run build:rollup && npm run build:webpack",
    "build:rollup": "rollup -c rollup.config.js",
    "build:webpack": "webpack --mode production --config webpack.config.mjs",
    "build:dev": "rollup -c rollup.config.js --watch",
    "build:docs": "mkdir -p docs-dist && cp -r docs/* docs-dist/",
    "dev": "webpack serve --mode development",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --passWithNoTests",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "clean": "rm -rf dist/ docs-dist/",
    "prepare": "npm run clean && npm run build",
    "prepublishOnly": "npm run lint && npm run build",
    "release:prepare": "node scripts/prepare-release.js",
    "release:check": "npm run release:prepare && npm pack --dry-run"
  },
  "keywords": [
    "audio",
    "visualizer",
    "ascii",
    "visualization",
    "music",
    "web-audio-api",
    "react",
    "frequency",
    "spectrum",
    "matrix",
    "animation",
    "realtime",
    "interactive",
    "component"
  ],
  "author": "Parallax Visualizer Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/parallax-visualizer.git"
  },
  "homepage": "https://yourusername.github.io/parallax-visualizer",
  "bugs": {
    "url": "https://github.com/yourusername/parallax-visualizer/issues"
  },
  "devDependencies": {
    "@babel/core": "^7.22.0",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/preset-env": "^7.22.0",
    "@rollup/plugin-babel": "^6.0.3",
    "@rollup/plugin-node-resolve": "^15.1.0",
    "@rollup/plugin-terser": "^0.4.3",
    "babel-loader": "^9.1.2",
    "eslint": "^8.44.0",
    "jest": "^29.6.0",
    "jest-environment-jsdom": "^30.1.2",
    "rollup": "^3.26.0",
    "typescript": "^5.1.0",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions"
  ]
}
